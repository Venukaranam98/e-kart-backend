            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
